---
import Base from '../layouts/Base.astro';

// Every Markdown file in src/posts becomes a post at /<file name>/, the same
// address it had on WordPress (for example /rp-solvers/).
export function getStaticPaths() {
  const modules = import.meta.glob('../posts/*.md', { eager: true }) as Record<string, any>;
  return Object.entries(modules).map(([path, post]) => ({
    params: { slug: path.split('/').pop()!.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, frontmatter } = post;

const date = new Date(frontmatter.date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="prose">
    <h1>{frontmatter.title}</h1>
    <p class="meta">
      <time datetime={String(frontmatter.date)}>{date}</time>
      {frontmatter.category && <span> in {frontmatter.category}</span>}
    </p>
    <Content />
  </article>
</Base>
